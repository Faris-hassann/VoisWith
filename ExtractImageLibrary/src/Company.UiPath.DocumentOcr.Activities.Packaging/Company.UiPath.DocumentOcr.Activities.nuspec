        <dependency id="PDFtoImage" version="[5.2.1]" />
        <dependency id="SkiaSharp" version="[3.119.4]" />
        <dependency id="BitMiracle.LibTiff.NET" version="[2.4.660]" />
        <dependency id="Tesseract" version="[5.2.0]" />
      </group>
    </dependencies>
  </metadata>
