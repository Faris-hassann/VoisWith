{
  "name": "testerbackend",
  "version": "1.0.0",
  "description": "Authorized black-box website testing backend powered by Playwright and OpenRouter.",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:ci": "npm test && npm run acceptance:deterministic",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "trueform:system-test": "node scripts/run-trueform-system-test.mjs",
    "acceptance:deterministic": "npm run build && node scripts/run-fixture-acceptance.mjs",
    "acceptance:live": "npm run build && node scripts/run-fixture-acceptance.mjs --live-ai",
    "acceptance:phase5-adversarial": "npm run build && node scripts/run-phase5-adversarial.mjs",
    "openrouter:smoke": "node scripts/openrouter-smoke.mjs",
    "fixture": "node tests/fixtures/test-site/server.mjs",
    "playwright:install:chrome": "playwright install chrome"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "minimatch": "^10.0.1",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "playwright": "^1.54.2",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.17.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
