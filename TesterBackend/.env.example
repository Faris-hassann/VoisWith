NODE_ENV=development
PORT=3000
LOG_LEVEL=info
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
AUTO_OPEN_SWAGGER=true

OPENROUTER_API_KEY=
# Required, exactly 3, only once OPENROUTER_API_KEY is set. Get current free models with: npm run openrouter:models
# Example shape (these ids rotate — do not assume they are still valid): vendor/model-name:free
OPENROUTER_MODELS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEMPERATURE=0.1
# Reasoning models spend part of this budget on hidden reasoning tokens before the answer.
OPENROUTER_MAX_OUTPUT_TOKENS=6000
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_MAX_RETRIES=2
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=TesterBackend
# Delay before every AI call after the first in a run, to stay under the shared free-tier rate ceiling.
AI_CALL_PACING_MS=1500

BROWSER_CHANNEL=chrome
BROWSER_HEADLESS=false
BROWSER_LAUNCH_TIMEOUT_MS=30000
PAGE_NAVIGATION_TIMEOUT_MS=30000
ACTION_TIMEOUT_MS=10000

MAX_CONCURRENT_RUNS=1
# Canonical hard crawl ceilings; smaller per-run values are allowed.
MAX_PAGES_PER_RUN=500
MAX_DEPTH_PER_RUN=7
MAX_ACTIONS_PER_PAGE=15
MAX_RUN_DURATION_SECONDS=10800
MAX_AI_CALLS_PER_RUN=25
MAX_AI_TEST_CASES_PER_RUN=400
MAX_OPENROUTER_TOKENS_PER_RUN=250000

ALLOW_PRIVATE_NETWORK_TARGETS=false
REQUIRE_HTTPS=true
ARTIFACT_ROOT=artifacts
ARTIFACT_RETENTION_DAYS=14
PROMPT_FILE_PATH=src/prompts/form-test-planner.system.md
LIVE_VIEW_ENABLED=true
LIVE_VIEW_FRAME_INTERVAL_MS=1500
SCREENSHOT_DIRECTORY=artifacts/screenshots
TRACE_DIRECTORY=artifacts/traces
TEST_RUN_ALLOWED_ORIGINS=
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_CHANNEL=chrome
AI_RESPONSE_TIMEOUT_MS=30000
NAVIGATION_TIMEOUT_MS=30000
